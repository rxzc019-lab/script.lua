    local function UpdateESP()
        for _, folder in pairs(ESPHolder:GetChildren()) do
            folder.Line.Visible = false
            folder.Box.Visible = false
            folder.HpBg.Visible = false
            folder.NameTag.Visible = false
        end

        if not ESP_Enabled then return end

        local activeColor = IsRainbowESP and Color3.fromHSV((tick() % 3) / 3, 1, 1) or CurrentESPColor

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")

                if hrp and hum and hum.Health > 0 then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local esp = GetESPObjects(p)
                        
                        local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                        local factor = 1000 / distance
                        local boxHeight = math.clamp(factor * 3.2, 10, 800)
                        local boxWidth = boxHeight * 0.65

                        -- 1. เส้นโยง ESP
                        local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        local endPos = Vector2.new(hrpPos.X, hrpPos.Y)
                        local dist = (startPos - endPos).Magnitude
                        local center = (startPos + endPos) / 2
                        local angle = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))

                        esp.Line.Size = UDim2.new(0, dist, 0, 1.5)
                        esp.Line.Position = UDim2.new(0, center.X, 0, center.Y)
                        esp.Line.Rotation = angle
                        esp.Line.BackgroundColor3 = activeColor
                        esp.Line.Visible = true

                        -- 2. กรอบสี่เหลี่ยม Box ESP
                        esp.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                        esp.Box.Position = UDim2.new(0, hrpPos.X - boxWidth/2, 0, hrpPos.Y - boxHeight/2)
                        esp.Box.UIStroke.Color = activeColor
                        esp.Box.Visible = true

                        -- 3. หลอดเลือด Health Bar
                        local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        esp.HpBg.Size = UDim2.new(0, 3, 0, boxHeight)
                        esp.HpBg.Position = UDim2.new(0, hrpPos.X - boxWidth/2 - 6, 0, hrpPos.Y - boxHeight/2)
                        esp.HpBg.HpFill.Size = UDim2.new(1, 0, hpPct, 0)
                        esp.HpBg.HpFill.Position = UDim2.new(0, 0, 1 - hpPct, 0)
                        esp.HpBg.Visible = true

                        -- 4. ชื่อ และ ระยะทาง
                        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local distMeter = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
                        esp.NameTag.Size = UDim2.new(0, 200, 0, 15)
                        esp.NameTag.Position = UDim2.new(0, hrpPos.X - 100, 0, hrpPos.Y - boxHeight/2 - 18)
                        esp.NameTag.Text = string.format("👤 %s [%dm]", p.DisplayName, distMeter)
                        esp.NameTag.Visible = true
                    end
                end
            end
        end
    end

